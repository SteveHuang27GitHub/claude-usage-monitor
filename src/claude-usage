#!/usr/bin/env python3
"""claude-usage — real-time Claude Code subscription usage monitor

Subcommands:
  record    read statusline JSON from stdin, store rate_limits (called by usage-statusline.js)
  fetch     query /api/oauth/usage and store the result (timer / manual)
  check     evaluate thresholds + burn rate, send desktop notifications if needed
  status    human-readable summary
  segment   ANSI fragment for the status line
  hook      JSON alert level for usage-guard.py
  config    print effective configuration
  checkpoint  emergency wrap-up: append DEVLOG.md entry from the transcript + git commit
              --cwd DIR --session ID --transcript PATH [--reason TEXT] [--force]

Flags: --notify (record/fetch: also run notifications), --quiet (fetch: no output)

State file : $CLAUDE_CONFIG_DIR/state/usage.json   (default ~/.claude/state/usage.json)
Config file: $CLAUDE_CONFIG_DIR/usage-monitor.json (optional, see config.example.json)
"""
import json
import os
import platform
import subprocess
import sys
import tempfile
import time
import urllib.request
from datetime import datetime

try:
    import fcntl
except ImportError:  # Windows
    fcntl = None

CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
STATE_DIR = os.path.join(CLAUDE_DIR, "state")
STATE_FILE = os.path.join(STATE_DIR, "usage.json")
LOCK_FILE = os.path.join(STATE_DIR, "usage.lock")
LOG_FILE = os.path.join(STATE_DIR, "usage-alerts.log")
CONFIG_FILE = os.path.join(CLAUDE_DIR, "usage-monitor.json")
CRED_FILE = os.path.join(CLAUDE_DIR, ".credentials.json")
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"

WINDOWS = ("five_hour", "seven_day")
LABEL = {"five_hour": "5h", "seven_day": "7d"}

DEFAULT_CONFIG = {
    "inner_statusline": "",                 # original statusLine command to wrap ("" = none)
    "thresholds": {"five_hour": [80, 90, 95], "seven_day": [90, 95]},
    "eta_warn_min": 15,                     # warn when 5h window is predicted to hit 100% within N min
    "eta_min_pct": 50,                      # ...but only once usage is above this %
    "sample_window_sec": 1200,              # burn-rate regression window
    "stale_sec": 600,                       # mark data stale after N sec without update
    "notify": True,                         # desktop notifications
    "eta_notify_repeat_sec": 600,
    "guard_repeat_sec": 300,                # min interval between context injections per level
    "heavy_tools": ["Agent", "Task", "Workflow"],
    "deny_level": 2,                        # PreToolUse denies heavy tools at/above this level
    "lang": "en",                           # "en" | "zh-TW"
    # --- graceful wrap-up (checkpoint) ---
    "checkpoint_level": 3,                  # auto-checkpoint at/above this level (0 = off)
    "checkpoint_repeat_sec": 600,           # min interval between auto-checkpoints per session
    "auto_commit": True,                    # git add -A && git commit in the session cwd
    "devlog_file": "DEVLOG.md",             # relative to repo root (or absolute); "" = no devlog
    "devlog_transcript_msgs": 4,            # last N assistant messages summarised into the devlog
    "devlog_transcript_chars": 1500,
}
MAX_SAMPLES = 200


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        with open(CONFIG_FILE) as f:
            user = json.load(f)
        for k, v in user.items():
            if k == "thresholds" and isinstance(v, dict):
                cfg["thresholds"].update(v)
            else:
                cfg[k] = v
    except Exception:
        pass
    return cfg


CFG = load_config()

# ------------------------------------------------------------------ i18n
MSG = {
    "en": {
        "no_data": "No usage data yet (appears after the session's first API response, or run: claude-usage fetch)",
        "reset": "resets {t}",
        "in": "in {d}",
        "reset_done": "(reset)",
        "burn": "burn rate: {s:.2f}%/min",
        "eta": ", ~{m:.0f} min to limit",
        "updated": "updated {a}s ago ({src})",
        "stale": "  ⚠ stale",
        "alerts": "alerts: ",
        "a_pct": "{w} usage {p:.0f}%, resets {t}",
        "a_eta": "5h burn rate {s:.1f}%/min, ~{m:.0f} min to limit",
        "n_pct_t": "Claude {w} usage {p:.0f}% (≥{th}%)",
        "n_pct_b": "resets {t}",
        "n_eta_t": "Claude 5h limit in ~{m:.0f} min",
        "n_eta_b": "now {p:.0f}%, burn rate {s:.1f}%/min",
    },
    "zh-TW": {
        "no_data": "尚無用量資料（session 第一次 API 回應後才會出現，或執行 claude-usage fetch）",
        "reset": "{t} 重置",
        "in": "還有 {d}",
        "reset_done": "(已重置)",
        "burn": "燃燒率: {s:.2f}%/min",
        "eta": "，預估 {m:.0f} 分鐘後到頂",
        "updated": "更新: {a}s 前 ({src})",
        "stale": "  ⚠ stale",
